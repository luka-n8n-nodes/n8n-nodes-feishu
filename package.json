{
  "name": "@luka-cat-mimi/n8n-nodes-feishu",
  "version": "1.0.0",
  "description": "飞书 n8n 社区节点，140+ API 集成，支持 WebSocket/Webhook 触发与多维表格增强操作",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "feishu",
    "飞书"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-feishu#readme",
  "author": {
    "name": "luka-cat",
    "email": "luka.cat.mimi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/luka-n8n-nodes/n8n-nodes-feishu.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node scripts/copy-proto.js",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "format": "prettier credentials nodes --write",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/FeishuNodeCredentialsApi.credentials.js",
      "dist/credentials/FeishuNodeOauth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FeishuNode/FeishuNode.node.js",
      "dist/nodes/FeishuNode/FeishuNodeTrigger.node.js",
      "dist/nodes/FeishuNode/FeishuWebhookTrigger.node.js",
      "dist/nodes/FeishuNode/RespondToFeishu.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.2.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "protobufjs": "^8.7.1",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
