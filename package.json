{
  "name": "@luka-cat-mimi/n8n-nodes-feishu",
  "version": "0.10.0",
  "description": "飞书 N8N 集成插件",
  "keywords": [
    "n8n",
    "n8n-node",
    "n8n-community-node-package",
    "feishu",
    "飞书"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/luka-n8n-nodes/n8n-nodes-feishu#readme",
  "author": {
    "name": "luka-cat",
    "email": "luka.cat.mimi@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luka-n8n-nodes/n8n-nodes-feishu.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "n8n-node build && node scripts/copy-proto.js",
    "dev": "n8n-node dev",
    "format": "prettier credentials nodes --write",
    "lint": "n8n-node lint",
    "lintfix": "n8n-node lint --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/FeishuNodeCredentialsApi.credentials.js",
      "dist/credentials/FeishuNodeOauth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FeishuNode/FeishuNode.node.js",
      "dist/nodes/FeishuNode/FeishuNodeTrigger.node.js",
      "dist/nodes/FeishuNode/FeishuWebhookTrigger.node.js",
      "dist/nodes/FeishuNode/RespondToFeishu.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^20.19.37",
    "@types/ws": "^8.5.13",
    "eslint": "9.39.4",
    "form-data": "^4.0.1",
    "glob": "^10.4.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "protobufjs": "^7.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
